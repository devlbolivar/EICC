# Configuración de entorno para tests de integración
# Copia este archivo como .env.test y ajusta los valores según tu entorno

NODE_ENV=test

# Configuración de JWT para testing
JWT_SECRET=test-secret-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Base de datos de testing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_auth_db

# Configuración de testing
TEST_TIMEOUT=10000
TEST_RETRIES=3

# Configuración de logs para testing
LOG_LEVEL=error
ENABLE_DEBUG_LOGS=false

# Configuración de seguridad para testing
ENABLE_RATE_LIMITING=false
ENABLE_CORS=false

# Configuración de performance para testing
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=5000

# Configuración de cobertura
COVERAGE_THRESHOLD=90
COVERAGE_REPORTERS=text,lcov,html 