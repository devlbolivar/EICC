# ============================================
# PLATAFORMA E-LEARNING - CONFIGURACIÓN DE ENTORNO
# ============================================
# Copia este archivo como .env.local y configura los valores reales

# ============================================
# BASE DE DATOS
# ============================================
# PostgreSQL connection string
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
# Ejemplo local: postgresql://postgres:postgres@localhost:5432/eicc_db
# Ejemplo Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql://user:password@localhost:5432/eicc_db

# ============================================
# SEGURIDAD - JWT
# ============================================
# IMPORTANTE: Genera un string aleatorio de al menos 32 caracteres
# Puedes generarlo con: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# STRIPE - SISTEMA DE PAGOS
# ============================================
# Obtén tus keys en: https://dashboard.stripe.com/apikeys

# Modo Test (desarrollo)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Modo Producción (comentado por defecto)
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# Price IDs de Stripe (crear en dashboard)
NEXT_PUBLIC_STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_xxx_premium_monthly
NEXT_PUBLIC_STRIPE_PRICE_ID_PREMIUM_YEARLY=price_xxx_premium_yearly
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_xxx_enterprise_monthly
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE_YEARLY=price_xxx_enterprise_yearly

# ============================================
# GOOGLE AI - GENERACIÓN DE CONTENIDO
# ============================================
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# ============================================
# EMAIL - SMTP
# ============================================
# Para desarrollo, usa Mailtrap: https://mailtrap.io
# Para producción, usa SendGrid, AWS SES, o similar

# Mailtrap (desarrollo)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password

# Producción (comentado por defecto)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Configuración de email
EMAIL_FROM=noreply@tu-plataforma.com
EMAIL_FROM_NAME=Plataforma E-Learning

# ============================================
# NEXT.JS
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# ============================================

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# ============================================
# NOTAS DE SEGURIDAD
# ============================================
# 1. NUNCA commitees este archivo con valores reales a Git
# 2. Usa .env.local para desarrollo local (ignorado por Git)
# 3. En producción, configura las variables en tu plataforma de hosting
# 4. Rota el JWT_SECRET regularmente en producción
# 5. Usa SIEMPRE modo test de Stripe hasta que estés listo para producción
